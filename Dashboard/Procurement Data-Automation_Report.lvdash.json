{
  "datasets": [
    {
      "name": "d5ca2ef6",
      "displayName": "Invoice Matching Summary and Review Metrics Dataset",
      "queryLines": [
        "SELECT\r\n",
        "    SUM(invoice_amount) AS total_invoice_value,\r\n",
        "\r\n",
        "    SUM(\r\n",
        "        CASE\r\n",
        "            WHEN overall_match THEN invoice_amount\r\n",
        "            ELSE 0\r\n",
        "        END\r\n",
        "    ) AS matched_invoice_value,\r\n",
        "\r\n",
        "    SUM(\r\n",
        "        CASE\r\n",
        "            WHEN NOT overall_match THEN invoice_amount\r\n",
        "            ELSE 0\r\n",
        "        END\r\n",
        "    ) AS unmatched_invoice_value,\r\n",
        "\r\n",
        "    COUNT(\r\n",
        "        CASE\r\n",
        "            WHEN NOT overall_match THEN 1\r\n",
        "        END\r\n",
        "    ) AS invoices_requiring_review\r\n",
        "\r\n",
        "FROM three_way_match_results;"
      ],
      "catalog": "dev_p2p",
      "schema": "gold"
    },
    {
      "name": "e13b4ad6",
      "displayName": "3 way invoice match analysis",
      "queryLines": [
        "SELECT\r\n",
        "    'Fully Matched (PO + GR)' AS category,\r\n",
        "    COUNT(*) AS count,\r\n",
        "    SUM(invoice_amount) AS total_value\r\n",
        "FROM three_way_match_results\r\n",
        "WHERE po_match AND gr_match\r\n",
        "\r\n",
        "UNION ALL\r\n",
        "\r\n",
        "SELECT\r\n",
        "    'PO Match Only',\r\n",
        "    COUNT(*),\r\n",
        "    SUM(invoice_amount)\r\n",
        "FROM three_way_match_results\r\n",
        "WHERE po_match AND NOT gr_match\r\n",
        "\r\n",
        "UNION ALL\r\n",
        "\r\n",
        "SELECT\r\n",
        "    'GR Match Only',\r\n",
        "    COUNT(*),\r\n",
        "    SUM(invoice_amount)\r\n",
        "FROM three_way_match_results\r\n",
        "WHERE gr_match AND NOT po_match\r\n",
        "\r\n",
        "UNION ALL\r\n",
        "\r\n",
        "SELECT\r\n",
        "    'No Matches',\r\n",
        "    COUNT(*),\r\n",
        "    SUM(invoice_amount)\r\n",
        "FROM three_way_match_results\r\n",
        "WHERE NOT po_match AND NOT gr_match;"
      ],
      "catalog": "dev_p2p",
      "schema": "gold"
    },
    {
      "name": "c439f005",
      "displayName": "Invoice Match Success Metric Summary",
      "queryLines": [
        "SELECT\r\n",
        "    COUNT(*) AS total_invoices,\r\n",
        "\r\n",
        "    SUM(\r\n",
        "        CASE\r\n",
        "            WHEN overall_match THEN 1\r\n",
        "            ELSE 0\r\n",
        "        END\r\n",
        "    ) AS fully_matched,\r\n",
        "\r\n",
        "    ROUND(\r\n",
        "        SUM(\r\n",
        "            CASE\r\n",
        "                WHEN overall_match THEN 1\r\n",
        "                ELSE 0\r\n",
        "            END\r\n",
        "        ) * 100.0 / COUNT(*),\r\n",
        "        2\r\n",
        "    ) AS match_success_rate_pct\r\n",
        "\r\n",
        "FROM three_way_match_results;"
      ],
      "catalog": "dev_p2p",
      "schema": "gold"
    },
    {
      "name": "dde57d05",
      "displayName": "Top Discrepancy types and Impact in Invoices",
      "queryLines": [
        "SELECT \r\n",
        "    invoice_number,\r\n",
        "    explode(discrepancies) AS discrepancy_type,\r\n",
        "    COUNT(*) AS frequency,\r\n",
        "    SUM(invoice_amount) AS impact_value\r\n",
        "FROM three_way_match_results\r\n",
        "WHERE SIZE(discrepancies) > 0\r\n",
        "GROUP BY 1,2\r\n",
        "ORDER BY frequency DESC\r\n",
        "LIMIT 10;"
      ],
      "catalog": "dev_p2p",
      "schema": "gold"
    },
    {
      "name": "4ab80099",
      "displayName": "Confidence Scores",
      "queryLines": [
        "SELECT\r\n",
        "    CASE\r\n",
        "        WHEN confidence >= 0.9 THEN 'High (90–100%)'\r\n",
        "        WHEN confidence >= 0.7 THEN 'Medium (70–89%)'\r\n",
        "        WHEN confidence >= 0.5 THEN 'Low (50–69%)'\r\n",
        "        ELSE 'Very Low (<50%)'\r\n",
        "    END AS confidence_level,\r\n",
        "\r\n",
        "    COUNT(*) AS invoice_count,\r\n",
        "    ROUND(AVG(confidence), 3) AS avg_confidence,\r\n",
        "    SUM(invoice_amount) AS total_value\r\n",
        "\r\n",
        "FROM three_way_match_results\r\n",
        "\r\n",
        "GROUP BY 1\r\n",
        "ORDER BY avg_confidence DESC;"
      ],
      "catalog": "dev_p2p",
      "schema": "gold"
    }
  ],
